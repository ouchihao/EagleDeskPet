<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EagleDeskPet.Mcp</AssemblyName>
    <Version>1.10.1</Version>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <Compile Include="..\DuckDeskPet\Integration\PetBridgeProtocol.cs" Link="Integration\PetBridgeProtocol.cs" />
    <Compile Include="..\DuckDeskPet\Integration\PetBridgeClient.cs" Link="Integration\PetBridgeClient.cs" />
  </ItemGroup>
</Project>
