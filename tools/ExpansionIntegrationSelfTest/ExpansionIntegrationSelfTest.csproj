<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../DuckDeskPet.Core/DuckDeskPet.Core.csproj" />
    <Compile Include="../../DuckDeskPet/WorkStageMotion.cs" Link="WorkStageMotion.cs" />
    <Compile Include="../../DuckDeskPet/SceneDefinition.cs" Link="SceneDefinition.cs" />
    <Compile Include="../../DuckDeskPet/SceneCatalog.cs" Link="SceneCatalog.cs" />
    <Compile Include="../../DuckDeskPet/WorkStageRenderer.cs" Link="WorkStageRenderer.cs" />
    <Compile Include="../../DuckDeskPet/RasterFramePlayer.cs" Link="RasterFramePlayer.cs" />
    <Compile Include="../../DuckDeskPet/AnimationAssets.cs" Link="AnimationAssets.cs" />
    <Compile Include="../../DuckDeskPet/OutfitCatalog.cs" Link="OutfitCatalog.cs" />
    <Compile Include="../../DuckDeskPet/HungryScenePreviewWindow.cs" Link="HungryScenePreviewWindow.cs" />
    <Page Include="../../DuckDeskPet/Themes/PetTheme.xaml" Link="Themes/PetTheme.xaml" />
    <Resource Include="../../DuckDeskPet/Assets/actions.json" Link="Assets/actions.json" />
    <Resource Include="../../DuckDeskPet/Assets/outfits.json" Link="Assets/outfits.json" Condition="Exists('../../DuckDeskPet/Assets/outfits.json')" />
    <Resource Include="../../DuckDeskPet/Assets/SceneProps/work-scenes.json" Link="Assets/SceneProps/work-scenes.json" />
    <Resource Include="../../DuckDeskPet/Assets/SceneProps/**/*.png" Link="Assets/SceneProps/%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="../../DuckDeskPet/Assets/mascot-animated-neutral.png" Link="Assets/mascot-animated-neutral.png" />
    <Resource Include="../../DuckDeskPet/Assets/Animations/HungryEnter/frame-*.png" Link="Assets/Animations/HungryEnter/%(Filename)%(Extension)" />
    <Resource Include="../../DuckDeskPet/Assets/Animations/HungryLoop/frame-*.png" Link="Assets/Animations/HungryLoop/%(Filename)%(Extension)" />
    <Resource Include="../../DuckDeskPet/Assets/Animations/HungryExit/frame-*.png" Link="Assets/Animations/HungryExit/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
