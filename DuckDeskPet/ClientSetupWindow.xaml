<Window x:Class="DuckDeskPet.ClientSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大头鹰 · AI 自动传话" Width="660" Height="710" MinWidth="460" MinHeight="440"
        Background="#FFF9EF" Foreground="#493827" FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" KeyDown="Window_OnKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/PetTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource PetButton}"/>
            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#E8ECDD" Padding="24,20">
            <StackPanel>
                <TextBlock Text="AI 自动传话" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="回复一结束，小鹰就来喊你。" Foreground="#79806A" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,18">
                <TextBlock Text="选择本机 AI 客户端" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                <ComboBox x:Name="ClientBox" Padding="10,8" FontSize="13" SelectionChanged="Client_OnChanged" AutomationProperties.Name="要配置的 AI 客户端">
                    <ComboBoxItem Content="Codex"/>
                    <ComboBoxItem Content="Claude Code"/>
                    <ComboBoxItem Content="CodeBuddy Code"/>
                </ComboBox>
                <TextBlock x:Name="ClientDescriptionText" Foreground="#81755F" FontSize="11" Margin="0,8,0,14"/>
                <Border Background="#FFFFFF" BorderBrush="#E6DCC9" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="一次配置，两条通路" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="MCP：让 AI 可以主动传话、查询小鹰状态。" FontSize="12" Margin="0,9,0,5"/>
                        <TextBlock Text="Stop Hook：客户端回复结束后自动提醒，不依赖 AI 记得调用工具。" FontSize="12"/>
                        <TextBlock Text="只传简短完成提醒，不读取聊天记录，也不配置模型、登录或 API Key。" FontSize="11" Foreground="#87846F" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <DockPanel Margin="0,17,0,7">
                    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="重新检查" Padding="10,5" Click="Refresh_OnClick"/>
                    <TextBlock Text="本机配置预览" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="PlanStatusText" FontSize="12" Foreground="#687958" Margin="0,0,0,7"/>
                <Border Background="#F2EDE3" CornerRadius="9" Padding="12">
                    <TextBox x:Name="TargetsText" Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="#6C624F"
                             VerticalScrollBarVisibility="Auto" MaxHeight="142" AutomationProperties.Name="将修改的配置文件路径"/>
                </Border>
                <TextBlock x:Name="NotesText" FontSize="11" Foreground="#83714E" Margin="0,10,0,7"/>
                <TextBlock Text="仅在点击接入或移除后写文件。保留其他 MCP 和 Hook，写入前先备份；配置期间请勿同时在客户端编辑这些文件。移动桌宠目录后需重新配置。" FontSize="11" Foreground="#8B816C" Margin="0,5,0,12"/>
                <Border x:Name="ResultBorder" Visibility="Collapsed" Background="#ECF0E6" CornerRadius="9" Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="ResultText" FontSize="12"/>
                        <TextBox x:Name="BackupsText" Visibility="Collapsed" Background="Transparent" BorderThickness="0" IsReadOnly="True"
                                 FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="TrustText" FontSize="12" Foreground="#786042" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#F2ECE0" BorderBrush="#E3D9C4" BorderThickness="0,1,0,0" Padding="20,13">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="RemoveButton" Content="移除小鹰配置" Margin="0,0,8,0" Background="#F5EFE5" Click="Remove_OnClick"/>
                <Button x:Name="InstallButton" Content="一键接入" Background="#DCE6CE" Click="Install_OnClick"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
