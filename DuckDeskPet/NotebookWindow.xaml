<Window x:Class="DuckDeskPet.NotebookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大头鹰 · 图钉便签墙" Width="836" Height="774" MinWidth="460" MinHeight="620"
        Background="#FFF9ED" Foreground="#263B42" FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ShowActivated="True"
        PreviewKeyDown="Window_OnPreviewKeyDown" Closed="Window_OnClosed" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/PetTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource PetButton}"/>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#FFFEF7"/><Setter Property="BorderBrush" Value="#C9B992"/>
                <Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="13"/>
                <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>
            <DrawingBrush x:Key="CorkTexture" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                <DrawingBrush.Drawing><DrawingGroup>
                    <GeometryDrawing Brush="#DBC49B" Geometry="M0,0 H24 V24 H0 Z"/>
                    <GeometryDrawing Brush="#1F8C6536"><GeometryDrawing.Geometry><GeometryGroup>
                        <EllipseGeometry Center="4,7" RadiusX="1.1" RadiusY="0.7"/>
                        <EllipseGeometry Center="17,19" RadiusX="0.7" RadiusY="1.1"/>
                        <EllipseGeometry Center="21,3" RadiusX="0.6" RadiusY="0.6"/>
                    </GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                </DrawingGroup></DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="#FFF9ED">
        <Grid x:Name="MainSurface">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Padding="24,18,24,17" BorderBrush="#DFCFAD" BorderThickness="0,0,0,1">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E1ECDA"/><GradientStop Color="#FAECD0" Offset="1"/></LinearGradientBrush></Border.Background>
                <Grid>
                    <StackPanel Margin="0,0,92,0">
                        <TextBlock Text="EAGLE NOTES / 把小事钉在这里" Foreground="#6B8068" FontSize="10"/>
                        <TextBlock Text="脑袋放空，便签上墙" FontSize="25" FontWeight="Bold" Margin="0,6,0,5" TextWrapping="Wrap"/>
                        <TextBlock Text="一张纸，一件事。做完一件，就收好一张。" FontSize="11" Foreground="#75806B" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Width="72" Height="75" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFF7D7" BorderBrush="#CDB78B" BorderThickness="1" CornerRadius="4" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                        <Border.RenderTransform><RotateTransform Angle="7"/></Border.RenderTransform>
                        <Grid><Image Source="Assets/mascot-animated-neutral.png" Width="64" Height="58" Margin="0,8,0,0"/>
                            <Ellipse Width="11" Height="11" Fill="#9F5F48" Stroke="#80452E" VerticalAlignment="Top" Margin="0,-5,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="20,13,20,10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Label Target="{Binding ElementName=ComposerBox}" Content="写下一件要做的事" FontSize="12" Padding="0,0,0,7" FontWeight="SemiBold"/>
                <TextBox x:Name="ComposerBox" Grid.Row="1" Height="67" MaxLength="1000" AutomationProperties.Name="新便签内容" TextChanged="Composer_OnTextChanged"/>
                <DockPanel Grid.Row="2" Margin="0,9,0,0" LastChildFill="True">
                    <Button x:Name="AddButton" Content="＋ 钉到墙上" DockPanel.Dock="Right" Style="{StaticResource PetPrimaryButton}" Click="Add_OnClick" Padding="17,8" Margin="10,0,0,0" ToolTip="Ctrl+Enter 保存新便签"/>
                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="DraftCountText" Text="0 / 1000 字符" FontSize="10" Foreground="#8B826E"/>
                        <TextBlock Text="Ctrl+Enter 钉好 · Enter 换行" FontSize="10" Foreground="#8B826E" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
            <DockPanel Grid.Row="2" Margin="20,0,20,8">
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" FontSize="10" Foreground="#8B826E" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <WrapPanel>
                    <RadioButton x:Name="ActiveTab" Content="便签墙" GroupName="Page" Style="{StaticResource PetChip}" IsChecked="True" Checked="Page_OnChecked"/>
                    <RadioButton x:Name="ArchiveTab" Content="已完成" GroupName="Page" Style="{StaticResource PetChip}" Checked="Page_OnChecked"/>
                </WrapPanel>
            </DockPanel>
            <Border Grid.Row="3" Margin="15,0,15,0" Background="#A48056" CornerRadius="11" Padding="8" BorderBrush="#957149" BorderThickness="1">
                <Border Background="{StaticResource CorkTexture}" CornerRadius="5" BorderBrush="#B19264" BorderThickness="1">
                    <Grid>
                        <ScrollViewer x:Name="WallScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="Wall_OnSizeChanged" Padding="7,10,7,18" CanContentScroll="False">
                            <ItemsControl x:Name="NotesItems" HorizontalAlignment="Center" AutomationProperties.Name="图钉便签墙">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid x:Name="PaperCard" Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding CardHeight, RelativeSource={RelativeSource AncestorType=Window}}" Margin="7,4,7,8" RenderTransformOrigin="0.5,0.5">
                                        <Border Margin="2,15,0,0" CornerRadius="2" BorderBrush="#907953" BorderThickness="0,0,0,2" Background="{Binding PaperBrush}">
                                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.19" Color="#60421F"/></Border.Effect>
                                            <Grid Margin="15,23,15,11">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Stamp}" FontSize="9" FontWeight="SemiBold" Foreground="#827253" Margin="0,0,0,11"/>
                                                <TextBlock Grid.Row="1" Text="{Binding Preview}" FontSize="14" LineHeight="23" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="#3D4439" ClipToBounds="True"/>
                                                <Button Grid.Row="2" Content="展开 / 编辑" Tag="{Binding Id}" Click="Edit_OnClick" HorizontalAlignment="Left" Padding="0,6" Background="Transparent" BorderThickness="0" FontSize="10" Foreground="#5C745F" Margin="0,4,0,5" AutomationProperties.Name="展开或编辑便签"/>
                                                <Grid Grid.Row="3">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Button Content="{Binding ActionLabel}" Tag="{Binding Id}" Click="Toggle_OnClick" Background="#66FFFFFF" BorderBrush="#7F9C8861" Padding="11,6" FontSize="11" IsEnabled="{Binding CanWrite}" HorizontalAlignment="Left"/>
                                                    <Button Grid.Column="1" Content="删除" Tag="{Binding Id}" Click="Delete_OnClick" Background="Transparent" BorderThickness="0" Padding="7,6" FontSize="10" Foreground="#967660" IsEnabled="{Binding CanWrite}" AutomationProperties.Name="永久删除便签，需要确认"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Path Data="M0,0 L14,0 L14,14 Z" Fill="#37AA8951" Width="14" Height="14" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                                        <Grid Width="24" Height="29" VerticalAlignment="Top" HorizontalAlignment="Center" IsHitTestVisible="False">
                                            <Path Data="M12,12 L14,28" Stroke="#715E50" StrokeThickness="2"/>
                                            <Ellipse Width="18" Height="18" VerticalAlignment="Top" Stroke="#894634" StrokeThickness="1">
                                                <Ellipse.Fill><RadialGradientBrush Center="0.3,0.25" GradientOrigin="0.3,0.25"><GradientStop Color="#E79B79"/><GradientStop Color="#B5644B" Offset="0.65"/><GradientStop Color="#934A36" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                                                <Ellipse.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="2" Opacity="0.3"/></Ellipse.Effect>
                                            </Ellipse>
                                            <Ellipse Width="5" Height="4" Fill="#8CFFF4D7" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,3,0,0"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border x:Name="EmptyState" Width="286" Padding="22" Background="#DCFFF8DB" BorderBrush="#B99C6E" BorderThickness="1" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><RotateTransform Angle="-2"/></Border.RenderTransform>
                            <StackPanel><TextBlock Text="今天先搞定一件小事" x:Name="EmptyTitle" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Foreground="#665C42"/>
                                <TextBlock x:Name="EmptyBody" Text="在上面写一句，替脑袋腾点位置。\n不催你打卡，也不给工作加班。" FontSize="11" Foreground="#8A7B59" TextWrapping="Wrap" TextAlignment="Center" Margin="0,13,0,0" LineHeight="20"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Border>
            <StackPanel Grid.Row="4" Margin="21,10,21,12">
                <TextBlock x:Name="StatusText" Foreground="#7E624A" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="仅存本机 · 含已完成最多 256 张 · 不自动设提醒 · 不发给 AI" FontSize="10" Foreground="#948A78" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
        <!-- One local dialog surface: disabled background and cyclic keyboard focus, no nested data service -->
        <Grid x:Name="DialogOverlay" Visibility="Collapsed" Background="#990F2428" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
            <Border x:Name="DialogCard" Margin="22" MaxWidth="550" Padding="24" Background="#FFF9E9" BorderBrush="#D5BF91" BorderThickness="1" CornerRadius="15" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="DialogTitle" FontSize="21" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DialogBody" Grid.Row="1" FontSize="12" LineHeight="20" Foreground="#877757" TextWrapping="Wrap" Margin="0,10,0,14"/>
                    <TextBox x:Name="EditorBox" Grid.Row="2" Height="210" MaxLength="1000" AutomationProperties.Name="完整便签内容"/>
                    <TextBlock x:Name="DialogStatus" Grid.Row="3" FontSize="11" Foreground="#A04434" TextWrapping="Wrap" Margin="0,9,0,4" AutomationProperties.LiveSetting="Polite"/>
                    <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="CancelDialogButton" Content="取消" Click="CancelDialog_OnClick" Padding="17,9" Margin="0,0,8,0"/>
                        <Button x:Name="SaveDialogButton" Content="保存修改" Click="SaveDialog_OnClick" Style="{StaticResource PetPrimaryButton}" Padding="17,9"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
