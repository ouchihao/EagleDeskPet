<Window x:Class="DuckDeskPet.CarePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大头鹰 · 饭搭子" Width="360" Height="640" ResizeMode="NoResize"
        Background="#FFF9EF" FontFamily="Microsoft YaHei UI" Foreground="#423323"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F4DEAC"/>
            <Setter Property="Foreground" Value="#493322"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22,18,22,20">
        <Grid>
            <StackPanel>
                <TextBlock Text="你的电子饭搭子" FontSize="11" Foreground="#94754F"/>
                <TextBlock Text="大头鹰" FontSize="27" FontWeight="Bold" Margin="0,4,0,3"/>
                <TextBlock x:Name="LevelText" Text="Lv.1  ·  初来乍到" FontSize="12"/>
            </StackPanel>
            <Image Source="Assets/mascot-animated-neutral.png" Width="92" Height="94" HorizontalAlignment="Right"/>
        </Grid>
        <Border Background="#FFFFFF" CornerRadius="14" Padding="14" Margin="0,15,0,12">
            <StackPanel>
                <DockPanel><TextBlock Text="饱食度"/><TextBlock x:Name="FullnessText" HorizontalAlignment="Right"/></DockPanel>
                <ProgressBar x:Name="FullnessBar" Height="6" Maximum="100" Margin="0,6,0,12" Foreground="#D7A04E" Background="#F5EDDD" BorderThickness="0"/>
                <DockPanel><TextBlock Text="心情"/><TextBlock x:Name="MoodText" HorizontalAlignment="Right"/></DockPanel>
                <ProgressBar x:Name="MoodBar" Height="6" Maximum="100" Margin="0,6,0,4" Foreground="#8CAE9E" Background="#EEF3EE" BorderThickness="0"/>
            </StackPanel>
        </Border>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="FoodButton" Grid.Column="0" Click="Feed_OnClick" PreviewMouseLeftButtonDown="Food_OnDown" PreviewMouseMove="Food_OnMove">
                <StackPanel><TextBlock Text="🍚  开饭" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="FoodText" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="PetButton" Grid.Column="2" Background="#E6EDE3" Click="Pet_OnClick">
                <StackPanel><TextBlock Text="摸摸头" FontSize="16" FontWeight="Bold"/><TextBlock Text="手法要温柔" FontSize="11" Margin="0,4,0,0"/></StackPanel>
            </Button>
        </Grid>
        <TextBlock Text="点开饭，或把饭拖到桌面上的小鹰身上。" FontSize="11" Foreground="#8D7961"/>
        <TextBlock x:Name="IncomeText" FontSize="11" Foreground="#8D7961" Margin="0,5,0,12"/>
        <TextBlock x:Name="StatusText" MinHeight="38" TextWrapping="Wrap" FontSize="12" Foreground="#846648"/>
        <Border Background="#F5E8CB" CornerRadius="12" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="WalletText" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="WageText" FontSize="10" TextWrapping="Wrap" Foreground="#846648" Margin="0,5,0,0"/>
                <TextBlock Text="鹰币只用于本地商店，无真实货币价值；旧档不补发历史工资。" FontSize="10" TextWrapping="Wrap" Foreground="#846648" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <Border Background="#ECE9E1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="WorkButton" DockPanel.Dock="Right" Content="开始工作" Padding="11,7" Background="#D9DFC9" Click="Work_OnClick"/>
                    <TextBlock x:Name="WorkText" Text="工位空着" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Margin="0,0,8,0"/>
                </DockPanel>
                <TextBlock Text="每有效工作分钟 +1 经验、+1 鹰币；每小时饱食 −12、心情 −10。30 分钟进入忙碌中，饿到 0 自动收工；隐藏 / 锁屏仍计时，离线最多 2 小时。" FontSize="10" TextWrapping="Wrap" Foreground="#8D7961" Margin="0,7,0,0"/>
            </StackPanel>
        </Border>
        <CheckBox x:Name="BanterCheck" Content="主动职场骚话 · 每分钟随机一句" Click="Banter_OnClick" Foreground="#806F58" FontSize="11" Margin="0,0,0,8"/>
        <Button x:Name="HonorWallButton" Click="HonorWall_OnClick" Background="#EFE5D4" Padding="12,10" Margin="0,6,0,8" HorizontalContentAlignment="Stretch">
            <Grid Width="258">
                <StackPanel Margin="0,0,18,0"><TextBlock Text="荣誉展览馆" FontSize="13" FontWeight="Bold"/><TextBlock x:Name="AchievementsText" TextWrapping="Wrap" FontSize="11" Foreground="#806F58" Margin="0,5,0,0"/></StackPanel>
                <TextBlock Text="›" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#9C7745"/>
            </Grid>
        </Button>
        <Button Click="GitHub_OnClick" Background="#E6EBDC" Padding="12,9" HorizontalContentAlignment="Left">
            <StackPanel><TextBlock Text="GitHub 消息" FontSize="13" FontWeight="Bold"/><TextBlock x:Name="GitHubStatusText" Text="连接后，由小鹰替你盯 PR。" FontSize="11" Foreground="#778062" Margin="0,4,0,0"/></StackPanel>
        </Button>
        <Separator Margin="0,15,0,12" Background="#E4D9C5"/>
        <Expander x:Name="AiSettingsExpander" Header="AI 传话与返回应用" Foreground="#806F58" FontSize="12">
        <StackPanel Margin="0,10,0,0">
        <Button x:Name="ClientSetupButton" Content="一键接入 AI · MCP + 自动提醒" Background="#DDE6D1" Click="ClientSetup_OnClick" Margin="0,0,0,12"/>
        <DockPanel>
            <TextBlock Text="AI 传话" FontSize="13" FontWeight="Bold"/>
            <CheckBox x:Name="NotificationsCheck" Content="接收提醒" HorizontalAlignment="Right" Click="Notifications_OnClick"/>
        </DockPanel>
        <TextBlock Text="来源名须与 MCP 的 --source 一致。返回应用只在本机配置。" TextWrapping="Wrap" FontSize="10" Foreground="#8D7961" Margin="0,6,0,8"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="SourceBox" IsEditable="True" Text="Codex" VerticalContentAlignment="Center" Padding="7" MaxDropDownHeight="120">
                <ComboBoxItem Content="Codex"/><ComboBoxItem Content="Claude Code"/><ComboBoxItem Content="CodeBuddy Code"/><ComboBoxItem Content="Gemini CLI"/>
            </ComboBox>
            <Button Grid.Column="2" Content="选择应用…" Padding="10,7" Click="ChooseApp_OnClick"/>
        </Grid>
        <TextBlock x:Name="AppPathText" TextWrapping="Wrap" FontSize="10" Foreground="#8D7961" Margin="0,7,0,7"/>
        <Button Content="试一下通知气泡" Padding="12,7" Background="#EAE5DC" Click="TestNotification_OnClick"/>
        </StackPanel>
        </Expander>
    </StackPanel>
    </ScrollViewer>
</Window>
