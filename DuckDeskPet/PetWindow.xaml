<Window x:Class="DuckDeskPet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小鹰桌宠"
        Width="200"
        Height="222"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/PetTheme.xaml"/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Root">
        <Grid x:Name="PetVisual"
              Width="160"
              Height="174"
              Background="Transparent"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,18"
              RenderTransformOrigin="0.5,0.92"
              Cursor="Hand"
              ClipToBounds="True"
              AllowDrop="True"
              DragOver="Food_OnDragOver"
              Drop="Food_OnDrop"
              PreviewMouseLeftButtonDown="PetVisual_OnMouseLeftButtonDown">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="PetRotation" Angle="0" />
                    <TranslateTransform x:Name="PetTranslation" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="BusyFireImage" Width="160" Height="174" Stretch="Uniform" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
            <Image x:Name="DeskBackImage" Width="160" Height="174" Stretch="Uniform" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
            <Image x:Name="PetImage"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Stretch="Uniform"
                   IsHitTestVisible="False"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Image x:Name="DeskFrontImage" Width="160" Height="174" Stretch="Uniform" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
            <Image x:Name="LaptopImage" Width="160" Height="174" Stretch="Uniform" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />

            <Grid.ContextMenu>
                <ContextMenu x:Name="PetMenu" Opened="ContextMenu_OnOpened" Style="{StaticResource PetContextMenu}">
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource PetMenuItem}"/>
                        <Style TargetType="Separator" BasedOn="{StaticResource PetMenuSeparator}"/>
                    </ContextMenu.Resources>
                    <MenuItem Header="我的饭搭子…" Click="CareMenu_OnClick" />
                    <MenuItem Header="荣誉展览馆…" Click="HonorMenu_OnClick" />
                    <MenuItem Header="鹰币小卖部 · 我的收藏…" Click="ShopMenu_OnClick" />
                    <MenuItem x:Name="GitHubMenuItem" Header="GitHub 消息…" Click="GitHubMenu_OnClick" />
                    <MenuItem x:Name="TaskInboxMenuItem" Header="AI 任务消息…" Click="TaskInboxMenu_OnClick" />
                    <MenuItem x:Name="ClientSetupMenuItem" Header="AI 自动传话 · 一键接入…" Click="ClientSetupMenu_OnClick" />
                    <Separator />
                    <MenuItem x:Name="TouchMenuItem" Header="摸摸头 · 害羞" Click="PetMenu_OnClick" />
                    <MenuItem x:Name="FeedMenuItem" Header="喂一份饭 · 干饭" Click="FeedMenu_OnClick" />
                    <MenuItem x:Name="YawnMenuItem" Header="打个哈欠" Tag="Yawn" Click="ClipMenuItem_OnClick" />
                    <MenuItem x:Name="GameMenuItem" Header="石头剪刀布 · 逗逗它…" Click="GameMenu_OnClick" />
                    <MenuItem Header="站立 · 默认待机" IsEnabled="False" />
                    <Separator />
                    <MenuItem x:Name="StartWorkMenuItem" Header="开始工作" Click="WorkMenu_OnClick" />
                    <MenuItem x:Name="StopWorkMenuItem" Header="取消工作 · 收工" Click="StopWorkMenu_OnClick" />
                    <Separator />
                    <MenuItem x:Name="BanterMenuItem" Header="主动职场骚话 · 每分钟" IsCheckable="True" Click="BanterMenu_OnClick" />
                    <MenuItem x:Name="EmotionMenuItem" Header="自主情绪小剧场 · 默认关闭" IsCheckable="True" Click="EmotionMenu_OnClick" />
                    <MenuItem Header="预览空碗小剧场…" Click="HungryPreviewMenu_OnClick" />
                    <MenuItem x:Name="PauseMenuItem" Header="暂停动作" IsCheckable="True" Click="PauseMenuItem_OnClick" />
                    <MenuItem x:Name="TopmostMenuItem" Header="保持置顶" IsCheckable="True" IsChecked="True" Click="TopmostMenuItem_OnClick" />
                    <MenuItem x:Name="FpsMenuItem" Header="显示帧率" IsCheckable="True" Click="FpsMenuItem_OnClick" />
                    <Separator />
                    <MenuItem x:Name="SizeRootMenuItem" Header="大小">
                        <MenuItem x:Name="SmallMenuItem" Header="小" Tag="0.80" IsCheckable="True" Click="SizeMenuItem_OnClick" />
                        <MenuItem x:Name="MediumMenuItem" Header="中" Tag="1.00" IsCheckable="True" Click="SizeMenuItem_OnClick" />
                        <MenuItem x:Name="LargeMenuItem" Header="大" Tag="1.28" IsCheckable="True" Click="SizeMenuItem_OnClick" />
                    </MenuItem>
                    <MenuItem Header="回到屏幕右下角" Click="ResetPositionMenuItem_OnClick" />
                    <Separator />
                    <MenuItem Header="退出" Click="ExitMenuItem_OnClick" />
                </ContextMenu>
            </Grid.ContextMenu>
        </Grid>

        <Button x:Name="GitHubUnreadBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,55,32,0" Padding="6,2" Background="#A9523F" Foreground="White" Cursor="Hand"
                Click="GitHubMenu_OnClick" ToolTip="查看 GitHub 未读消息" AutomationProperties.Name="GitHub 未读消息">
            <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border></ControlTemplate></Button.Template>
            <TextBlock x:Name="GitHubUnreadText" FontSize="10" FontWeight="Bold" Text="1"/>
        </Button>

        <Border x:Name="FpsBadge"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="8"
                Padding="7,3"
                CornerRadius="8"
                Background="#D92B2D42"
                IsHitTestVisible="False">
            <TextBlock x:Name="FpsText"
                       Foreground="White"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Text="-- FPS" />
        </Border>
    </Grid>
</Window>
