<Window x:Class="DuckDeskPet.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大头鹰 · 定时提醒" Width="550" Height="760" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#FFF8EB" Foreground="#24364B"
        FontFamily="Microsoft YaHei UI" PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/PetTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource PetButton}"/>
            <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#FFFEF9"/><Setter Property="BorderBrush" Value="#C9D5C6"/><Setter Property="BorderThickness" Value="1"/></Style>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderBrush="#CFDCCB" BorderThickness="0,0,0,1" Padding="24,18">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#DDECE1"/><GradientStop Color="#F4EDD9" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid>
                <StackPanel>
                    <TextBlock Text="EAGLE TIME / 让鹰替你记着" FontSize="10" Foreground="#637F6B"/>
                    <TextBlock Text="到点，喊你一声" FontSize="25" FontWeight="Bold" Margin="0,7,0,4"/>
                    <TextBlock Text="喝口水、伸个懒腰，也别忘了那件小事。" FontSize="11" Foreground="#687D70"/>
                </StackPanel>
                <Grid Width="84" Height="84" HorizontalAlignment="Right" Margin="0,-8,0,-6" IsHitTestVisible="False">
                    <Ellipse Fill="#FFFCF3" Stroke="#9AB79F" StrokeThickness="3"/>
                    <Path Stroke="#547460" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 42,13 L 42,42 L 61,50"/>
                    <Image Source="Assets/mascot-animated-neutral.png" Width="54" Height="51" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-14,-4"/>
                </Grid>
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="20,16,20,12">
            <WrapPanel Margin="0,0,0,11">
                <Button Content="喝水 · 20 分钟" Tag="water" Click="Preset_OnClick" Background="#E1EDDF" Padding="12,7" Margin="0,0,8,5"/>
                <Button Content="起身 · 45 分钟" Tag="stretch" Click="Preset_OnClick" Background="#F4E7CD" Padding="12,7" Margin="0,0,8,5"/>
                <Button Content="记一件事" Tag="custom" Click="Preset_OnClick" Padding="12,7" Margin="0,0,0,5"/>
            </WrapPanel>
            <DockPanel Margin="0,0,0,10">
                <CheckBox x:Name="RepeatCheck" DockPanel.Dock="Right" Content="按此间隔重复" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="12"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="MinutesBox" Text="20" Width="84" MaxLength="5" AutomationProperties.Name="提醒间隔分钟"/>
                    <TextBlock Text="分钟后提醒我" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="#69796D"/>
                </StackPanel>
            </DockPanel>
            <TextBox x:Name="MessageBox" Text="喝口水吧，别光给工作续杯。" MaxLength="120" AutomationProperties.Name="提醒内容" Margin="0,0,0,10"/>
            <DockPanel>
                <Button x:Name="AddButton" Content="＋ 交给小鹰记着" Click="Add_OnClick" Style="{StaticResource PetPrimaryButton}" DockPanel.Dock="Right" Padding="14,8"/>
                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="CountText" Foreground="#687D70" FontSize="11"/><TextBlock Text="仅存本机 · 不发给 AI" FontSize="10" Foreground="#9A907B" Margin="0,4,0,0"/></StackPanel>
            </DockPanel>
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="#9E6748" TextWrapping="Wrap" Margin="0,9,0,0" AutomationProperties.LiveSetting="Polite"/>
            <Border Background="#EAF1E5" CornerRadius="12" Padding="12,10" Margin="0,10,0,0">
                <StackPanel>
                    <WrapPanel>
                        <CheckBox x:Name="NativeCheck" Content="Windows 原生通知" Click="Channels_OnClick" Margin="0,0,16,7" FontWeight="SemiBold"/>
                        <CheckBox x:Name="BubbleCheck" Content="小鹰辅助气泡" Click="Channels_OnClick" Margin="0,0,0,7"/>
                    </WrapPanel>
                    <TextBlock Text="开启后到点直接交给 Windows，不必等小鹰忙完；首次使用请先发送测试通知。" FontSize="10" Foreground="#637F6B" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="发送测试通知" Click="TestNotification_OnClick" Padding="10,5" FontSize="11" Margin="0,0,8,0"/>
                        <Button Content="Windows 通知设置" Click="NotificationSettings_OnClick" Padding="10,5" FontSize="11"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <Grid Grid.Row="2" Margin="16,0,16,10" MinHeight="140">
            <ListBox x:Name="ReminderList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                     MaxHeight="290"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="本地提醒列表">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <Border Background="#FFFEF7" BorderBrush="#D8DFCE" BorderThickness="1,1,1,3" CornerRadius="14" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{Binding Message}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <DockPanel Grid.Row="1">
                                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Content="{Binding ToggleLabel}" Tag="{Binding Id}" Click="Toggle_OnClick" Padding="10,6" FontSize="11" Background="#E4EDDF" Margin="8,0,6,0"/>
                                    <Button Content="删除" Tag="{Binding Id}" Click="Delete_OnClick" Padding="9,6" FontSize="11"/>
                                </WrapPanel>
                                <StackPanel><TextBlock Text="{Binding RemainingLabel}" FontSize="18" FontFamily="Consolas, Microsoft YaHei UI" Foreground="#4D7666"/><TextBlock Text="{Binding StateLabel}" FontSize="10" Foreground="#9A917E" Margin="0,3,0,0"/></StackPanel>
                            </DockPanel>
                            <TextBlock Grid.Row="2" Text="{Binding NativeLabel}" Foreground="#8A7155" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18" IsHitTestVisible="False">
                <TextBlock Text="今天要记住什么？" FontSize="18" Foreground="#638271" HorizontalAlignment="Center"/>
                <TextBlock Text="选个小习惯，或者留一句给未来的自己。" FontSize="11" Foreground="#A3967F" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="3" Background="#F1EDDE" Padding="20,12">
            <TextBlock FontSize="10" Foreground="#8A826D" TextWrapping="Wrap" LineHeight="16"
                       Text="暂停冻结剩余时间；动作暂停不影响计时。原生通知独立投递，勿扰、锁屏与系统开关可能隐藏横幅；已提交不代表已显示或已读。失败或中断保留结果，本轮不自动重发。气泡避让 AI / GitHub，至少间隔 30 秒。退出后不后台运行、不唤醒；重启合并逾期一次。"/>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
