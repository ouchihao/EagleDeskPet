<Window x:Class="DuckDeskPet.GitHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大头鹰 · GitHub 消息" Width="650" Height="760" MinWidth="440" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#FFF8EB" Foreground="#24364B"
        FontFamily="Microsoft YaHei UI" PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/PetTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource PetButton}"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderBrush="#D8CCB3" BorderThickness="0,0,0,1" Padding="22,18" MinHeight="130">
            <Border.Background><ImageBrush ImageSource="Assets/Ui/club-post-v1.png" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center"/></Border.Background>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="EAGLE POST / 代码来信" FontSize="10" Foreground="#807349"/>
                    <TextBlock Text="GitHub 小邮局" FontSize="25" FontWeight="Bold" Margin="0,8,0,5"/>
                    <TextBlock x:Name="AccountText" FontSize="12" Text="可选连接 · 只在本机运行" Foreground="#647452"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#FFF8EB" CornerRadius="12" Padding="13,9" VerticalAlignment="Center" BorderBrush="#D2AF64" BorderThickness="1">
                    <StackPanel><TextBlock x:Name="UnreadText" Text="0" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#647452"/><TextBlock Text="本地未读" FontSize="10" Foreground="#939978"/></StackPanel>
                </Border>
            </Grid>
        </Border>
        <Expander x:Name="ConnectionExpander" Grid.Row="1" Header="连接与隐私设置" Margin="22,14,22,6" IsExpanded="True" FontSize="12">
            <ScrollViewer MaxHeight="244" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,10,0,8">
                    <TextBlock Text="不用填写 GitHub 密码。创建一个 classic Token，勾选 notifications，再粘贴到下面。细粒度 Token 暂不支持这个通知接口。" FontSize="11" Foreground="#8A7963" TextWrapping="Wrap"/>
                    <Grid Margin="0,10,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TokenBox" Grid.Column="0" MaxLength="256" Padding="9,8" Background="#FFFEFB" BorderBrush="#D8CCB6" BorderThickness="1"
                                     VerticalContentAlignment="Center" ToolTip="Personal access token (classic)，仅在本机加密保存" AutomationProperties.Name="GitHub classic Token"/>
                        <Button x:Name="ConnectButton" Grid.Column="2" Content="验证并连接" Click="Connect_OnClick" Style="{StaticResource PetPrimaryButton}"/>
                    </Grid>
                    <WrapPanel>
                        <Button Content="去 GitHub 创建 Token ↗" Click="CreateToken_OnClick" Padding="10,6" Margin="0,0,8,6" FontSize="11"/>
                        <Button x:Name="DisconnectButton" Content="断开并清除本机消息" Click="Disconnect_OnClick" Padding="10,6" Margin="0,0,0,6" FontSize="11" Background="#F0E2D9"/>
                    </WrapPanel>
                    <TextBlock Text="凭据由 Windows 为当前用户加密保存，不上传给 AI、不写入源码。仅发出读取请求，不代你回复、合并 PR 或标记 GitHub 已读。" TextWrapping="Wrap" FontSize="10" Foreground="#9A8B74" Margin="0,3,0,8"/>
                    <CheckBox x:Name="AllNotificationsCheck" Content="显示全部订阅通知（默认只看与我有关的消息）" Click="Filter_OnClick" FontSize="11" Foreground="#786E5B"/>
                </StackPanel>
            </ScrollViewer>
        </Expander>
        <StackPanel Grid.Row="2" Margin="22,4,22,10">
            <Border Background="#F4ECDD" CornerRadius="9" Padding="10,8">
                <TextBlock x:Name="StatusText" Text="尚未连接 GitHub。连接后先收好旧消息，只提醒之后的新动态。" FontSize="11" TextWrapping="Wrap" Foreground="#8C7352" AutomationProperties.LiveSetting="Polite"/>
            </Border>
            <DockPanel Margin="0,11,0,0">
                <WrapPanel DockPanel.Dock="Right">
                    <Button x:Name="PollButton" Content="检查消息" Click="Poll_OnClick" FontSize="11" Padding="10,6" Margin="0,0,7,0"/>
                    <Button x:Name="SeenButton" Content="本地全部看过" Click="Seen_OnClick" FontSize="11" Padding="10,6"/>
                </WrapPanel>
                <TextBlock Text="小鹰收件箱" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
        <Grid Grid.Row="3" Margin="16,0,16,8">
            <ListBox x:Name="InboxList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="GitHub 通知列表">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <Border Background="#FFFEF7" BorderBrush="#DCCCA9" BorderThickness="1,1,1,3" CornerRadius="13" Padding="15,13">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="●" Foreground="#B76542" FontSize="9" Margin="0,2,7,0" DockPanel.Dock="Left">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsSeen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Repository}" FontSize="11" Foreground="#7A8062" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" Margin="0,7,0,6" ToolTip="{Binding Title}"/>
                            <TextBlock Text="{Binding ReasonLabel}" FontSize="10" Foreground="#9A8B74"/>
                            <DockPanel Margin="0,8,0,0">
                                <Button Content="去看看 ↗" DockPanel.Dock="Right" Padding="9,5" FontSize="10" Tag="{Binding}" Click="OpenItem_OnClick" Background="#E7EBD9"/>
                                <TextBlock Text="{Binding UpdatedLabel}" FontSize="10" Foreground="#AA9A80" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="25,20" IsHitTestVisible="False">
                <Image Source="Assets/mascot-animated-neutral.png" Width="100" Height="96" Margin="0,0,0,10"/>
                <TextBlock Text="信箱空空，摸鱼正好" FontSize="18" FontWeight="Bold" Foreground="#607569" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyText" Text="连接 GitHub 后，与你有关的通知会出现在这里。" FontSize="11" Foreground="#AA9F8A" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="4" BorderBrush="#E4D9C4" BorderThickness="0,1,0,0" Padding="22,11" Background="#F6F0E3">
            <TextBlock Text="约每分钟检查，遵守 GitHub 限流 · 显示最近 200 条本地记录 · 小红点不会因气泡消失而清空" FontSize="10" TextWrapping="Wrap" Foreground="#96866C"/>
        </Border>
    </Grid>
</Window>
