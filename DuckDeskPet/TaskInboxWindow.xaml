<Window x:Class="DuckDeskPet.TaskInboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大头鹰 · 任务小信使" Width="590" Height="650" MinWidth="430" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#FFF8EB" Foreground="#24364B"
        FontFamily="Microsoft YaHei UI" PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/PetTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource PetButton}"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="22,18" MinHeight="130" BorderBrush="#D8CCB3" BorderThickness="0,0,0,1">
            <Border.Background><ImageBrush ImageSource="Assets/Ui/club-post-v1.png" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center"/></Border.Background>
            <StackPanel>
                <TextBlock Text="EAGLE POST / 任务来信" FontSize="10" Foreground="#807349"/>
                <TextBlock Text="任务小信使" FontSize="25" FontWeight="Bold" Margin="0,8,0,6"/>
                <TextBlock x:Name="SummaryText" FontSize="12" Foreground="#647452"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="20,14,20,12">
            <WrapPanel>
                <CheckBox x:Name="EnabledCheck" Content="接收任务更新" Click="Enabled_OnClick" Margin="0,0,18,9" FontSize="12"/>
                <CheckBox x:Name="MutedCheck" Content="静音气泡（仍收件）" Click="Muted_OnClick" Margin="0,0,0,9" FontSize="12"/>
            </WrapPanel>
            <TextBlock x:Name="ModeText" FontSize="11" TextWrapping="Wrap" Foreground="#8C7352" Margin="0,0,0,10"/>
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <Button x:Name="ReadAllButton" Content="全部已读" Click="ReadAll_OnClick" FontSize="11" Padding="10,6" Margin="0,0,7,0"/>
                    <Button x:Name="ClearButton" Content="清空本机消息" Click="Clear_OnClick" FontSize="11" Padding="10,6"/>
                </WrapPanel>
                <CheckBox x:Name="UnreadOnlyCheck" Content="只看未读" Click="Filter_OnClick" VerticalAlignment="Center" FontSize="11"/>
            </DockPanel>
        </StackPanel>
        <Grid Grid.Row="2" Margin="16,0,16,8">
            <ListBox x:Name="TaskList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="本机任务收件箱">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <Border Background="#FFFEF7" BorderBrush="#DCCCA9" BorderThickness="1,1,1,3" CornerRadius="13" Padding="15,13">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="●" Foreground="#B76542" FontSize="9" Margin="0,2,7,0" DockPanel.Dock="Left">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsUnread}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <Border DockPanel.Dock="Right" Background="#E3EDDE" CornerRadius="7" Padding="7,3"><TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="#587465"/></Border>
                                <TextBlock Text="{Binding Source}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TaskId, StringFormat='任务 · {0}'}" FontSize="10" Foreground="#8F897C" TextTrimming="CharacterEllipsis" ToolTip="{Binding TaskId}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" MaxHeight="90" TextTrimming="CharacterEllipsis" Margin="0,6,0,8"/>
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Right">
                                    <Button Content="已读" Tag="{Binding}" Click="Read_OnClick" Padding="9,5" FontSize="10" Margin="0,0,6,0"/>
                                    <Button Content="打开应用 ↗" Tag="{Binding}" Click="Open_OnClick" Padding="9,5" FontSize="10" Background="#E7EBD9"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding Revision, StringFormat='版本 {0}'}" FontSize="10" Foreground="#AA9A80" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" IsHitTestVisible="False">
                <Image Source="Assets/mascot-animated-neutral.png" Width="100" Height="96" Margin="0,0,0,10"/>
                <TextBlock Text="收件员正在等下一封来信" TextAlignment="Center" Foreground="#607569" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="只有来源明确发送的任务更新才会出现在这里。" TextWrapping="Wrap" TextAlignment="Center" Foreground="#8F8A76" FontSize="11" Margin="0,9,0,0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="3" Padding="20,10,20,14" Background="#F4ECDD">
            <TextBlock Text="仅保留在本次运行内存中，最多 64 项 / 24 小时。非终态 10 分钟未更新显示未知；Stop 只代表回复就绪。开关本次运行有效；清空保留有限去重标记，不保留正文。" FontSize="10" Foreground="#9A8B74" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
