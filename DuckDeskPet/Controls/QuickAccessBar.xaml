<UserControl x:Class="DuckDeskPet.Controls.QuickAccessBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DuckDeskPet.Controls"
             Width="208" Height="52" Focusable="False"
             UseLayoutRounding="True" FontFamily="Microsoft YaHei UI"
             AutomationProperties.Name="小鹰快捷入口">
    <UserControl.Resources>
        <SolidColorBrush x:Key="QuickAccessInk" Color="#696557"/>
        <Style x:Key="QuickAccessToolTip" TargetType="ToolTip">
            <Setter Property="Foreground" Value="#5E5546"/>
            <Setter Property="Background" Value="#FFFDF7"/>
            <Setter Property="BorderBrush" Value="#DDC9A7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Placement" Value="Top"/>
            <Setter Property="VerticalOffset" Value="-5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickAccessButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="240"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="100"/>
            <Setter Property="ToolTipService.ShowDuration" Value="5000"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" Background="Transparent">
                            <Grid RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="MotionScale"/>
                                        <TranslateTransform x:Name="MotionLift"/>
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                        BorderBrush="#24A78651" BorderThickness="1"
                                        CornerRadius="10" Opacity="0"/>
                                <ContentPresenter x:Name="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="FocusRing" Margin="1" CornerRadius="9"
                                        BorderBrush="#98743D" BorderThickness="1.5" Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="1"/>
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="1"/>
                                <Setter TargetName="Surface" Property="Background" Value="#EADDC4"/>
                                <Setter TargetName="Icon" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickAccessLine" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource QuickAccessInk}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Border Margin="6,4,6,8" CornerRadius="20" BorderThickness="1"
                BorderBrush="#C7C4A16B" Padding="7,3">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FAFFFDF7"/>
                    <GradientStop Color="#F5FFF5E3" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#715430" BlurRadius="7" ShadowDepth="2" Opacity="0.18"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Cycle"
                        KeyboardNavigation.DirectionalNavigation="Cycle">
                <Button x:Name="ShopButton" Style="{StaticResource QuickAccessButton}"
                        Background="#F5E5DD" AutomationProperties.Name="商店"
                        Tag="{x:Static local:QuickAccessDestination.Shop}" Click="Action_OnClick">
                    <Button.ToolTip><ToolTip Style="{StaticResource QuickAccessToolTip}" Content="商店"/></Button.ToolTip>
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource QuickAccessLine}" Fill="#FFF8EA"
                                  Data="M4.5,10 L4.5,20 Q4.5,21 5.5,21 L18.5,21 Q19.5,21 19.5,20 L19.5,10"/>
                            <Path Style="{StaticResource QuickAccessLine}" Fill="#E8B2A0"
                                  Data="M4.5,3.5 L19.5,3.5 L22,8.5 Q22,11 19.5,11 Q17,11 17,8.5 Q17,11 14.5,11 Q12,11 12,8.5 Q12,11 9.5,11 Q7,11 7,8.5 Q7,11 4.5,11 Q2,11 2,8.5 Z"/>
                            <Path Stroke="#FFF6E9" StrokeThickness="1.2" Data="M8,4.4 L7.3,7.8 M16,4.4 L16.7,7.8"/>
                            <Path Style="{StaticResource QuickAccessLine}" Fill="#E8C98E"
                                  Data="M9.5,21 L9.5,15 Q9.5,14 10.5,14 L13.5,14 Q14.5,14 14.5,15 L14.5,21"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="NotebookButton" Style="{StaticResource QuickAccessButton}"
                        Background="#F6EDCF" AutomationProperties.Name="便签"
                        Tag="{x:Static local:QuickAccessDestination.Notebook}" Click="Action_OnClick">
                    <Button.ToolTip><ToolTip Style="{StaticResource QuickAccessToolTip}" Content="便签"/></Button.ToolTip>
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource QuickAccessLine}" Fill="#F6DFA2"
                                  Data="M5,4.5 L18.5,4.5 Q20,4.5 20,6 L20,15.5 L14.5,21 L5,21 Q3.5,21 3.5,19.5 L3.5,6 Q3.5,4.5 5,4.5 Z"/>
                            <Path Style="{StaticResource QuickAccessLine}" Fill="#FFF8E7"
                                  Data="M14.5,21 L14.5,17 Q14.5,15.5 16,15.5 L20,15.5"/>
                            <Path Style="{StaticResource QuickAccessLine}" Stroke="#B29459" Data="M7.5,11 L15.5,11 M7.5,14.5 L11.5,14.5"/>
                            <Path Stroke="#A66F5D" StrokeThickness="1.4" StrokeEndLineCap="Round" Data="M12,4.5 L12,8"/>
                            <Ellipse Canvas.Left="9.8" Canvas.Top="1.5" Width="4.4" Height="4.4"
                                     Fill="#D89B85" Stroke="#A66F5D" StrokeThickness="1.2"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="TimerButton" Style="{StaticResource QuickAccessButton}"
                        Background="#E1EDF0" AutomationProperties.Name="定时器"
                        Tag="{x:Static local:QuickAccessDestination.Timer}" Click="Action_OnClick">
                    <Button.ToolTip><ToolTip Style="{StaticResource QuickAccessToolTip}" Content="定时器"/></Button.ToolTip>
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource QuickAccessLine}" Data="M10,2 L14,2 M12,2 L12,4.5 M18.5,5.5 L20,4"/>
                            <Ellipse Canvas.Left="3.5" Canvas.Top="4.5" Width="17" Height="17"
                                     Fill="#A8C9CF" Stroke="{StaticResource QuickAccessInk}" StrokeThickness="1.5"/>
                            <Ellipse Canvas.Left="6.5" Canvas.Top="7.5" Width="11" Height="11" Fill="#FFFDF4"/>
                            <Path Style="{StaticResource QuickAccessLine}" Data="M12,9 L12,13 L15,14.5"/>
                            <Ellipse Canvas.Left="11" Canvas.Top="12" Width="2" Height="2" Fill="{StaticResource QuickAccessInk}"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="HomeButton" Style="{StaticResource QuickAccessButton}"
                        Background="#E5EDDF" AutomationProperties.Name="主页"
                        Tag="{x:Static local:QuickAccessDestination.Home}" Click="Action_OnClick">
                    <Button.ToolTip><ToolTip Style="{StaticResource QuickAccessToolTip}" Content="主页"/></Button.ToolTip>
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource QuickAccessLine}" Fill="#C2D2AD"
                                  Data="M4.5,10 L4.5,19.5 Q4.5,21 6,21 L18,21 Q19.5,21 19.5,19.5 L19.5,10"/>
                            <Path Style="{StaticResource QuickAccessLine}" Fill="#FFF5DC"
                                  Data="M2.5,10.5 L11,3.5 Q12,2.7 13,3.5 L21.5,10.5"/>
                            <Path Style="{StaticResource QuickAccessLine}" Fill="#FFF9E9"
                                  Data="M9,21 L9,17.5 Q9,14.5 12,14.5 Q15,14.5 15,17.5 L15,21"/>
                            <Path Stroke="#76866C" StrokeThickness="1.4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M8.5,10 Q10.5,9.3 12,11 Q13.5,9.3 15.5,10"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="HonorsButton" Style="{StaticResource QuickAccessButton}"
                        Background="#EEE5F0" AutomationProperties.Name="荣誉室"
                        Tag="{x:Static local:QuickAccessDestination.Honors}" Click="Action_OnClick">
                    <Button.ToolTip><ToolTip Style="{StaticResource QuickAccessToolTip}" Content="荣誉室"/></Button.ToolTip>
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="#89758D" StrokeThickness="1.4" StrokeLineJoin="Round" Fill="#C6AFCC"
                                  Data="M7,13 L4.5,21 L8.5,19.5 L10.5,22 L12,15 M17,13 L19.5,21 L15.5,19.5 L13.5,22 L12,15"/>
                            <Ellipse Canvas.Left="4.5" Canvas.Top="2" Width="15" Height="15"
                                     Fill="#F0D39A" Stroke="{StaticResource QuickAccessInk}" StrokeThickness="1.5"/>
                            <Ellipse Canvas.Left="7" Canvas.Top="4.5" Width="10" Height="10"
                                     Fill="#FFF5D9" Stroke="#D0AA63" StrokeThickness="0.9"/>
                            <Path Fill="#C99E52" StrokeLineJoin="Round"
                                  Data="M12,5.8 L13.2,8.2 L15.9,8.6 L13.9,10.5 L14.4,13.2 L12,11.9 L9.6,13.2 L10.1,10.5 L8.1,8.6 L10.8,8.2 Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
