<Window x:Class="DuckDeskPet.PurchaseConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大头鹰 · 确认收藏" Width="388" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#26384C" FontFamily="Microsoft YaHei UI" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/PetTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource PetButton}"/>
            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="#FFFBF1" BorderBrush="#C9B888" BorderThickness="1" CornerRadius="19" Margin="5">
        <Border.Effect><DropShadowEffect Color="#26384C" BlurRadius="9" ShadowDepth="1" Opacity="0.2"/></Border.Effect>
        <StackPanel>
            <Border Background="#E2EBDD" CornerRadius="18,18,0,0" Padding="17,12,11,12" MouseLeftButtonDown="Title_OnMouseLeftButtonDown">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="EAGLE CLUB / 收藏一份快乐" FontSize="10" Foreground="#617767"/><TextBlock Text="把它带回小窝？" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="1" Content="×" Style="{StaticResource PetIconButton}" FontSize="18" Padding="5" Click="Cancel_OnClick" VerticalAlignment="Top" AutomationProperties.Name="关闭并取消购买" TabIndex="2"/>
                </Grid>
            </Border>
            <StackPanel Margin="21,15,21,18">
                <Border Background="#F2E8D2" CornerRadius="13" BorderBrush="#E3D2AC" BorderThickness="1" Padding="16,10">
                    <StackPanel>
                        <Image x:Name="ProductImage" Height="86" Margin="0,0,0,7" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="ProductName" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock x:Name="ProductPrice" FontSize="14" FontWeight="Bold" Foreground="#9E702A" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Grid Margin="2,13,2,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="我的鹰币" FontSize="11" Foreground="#7D806E"/><TextBlock x:Name="CurrentBalance" Grid.Column="1" FontSize="11" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="2,5,2,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="购买后剩余" FontSize="11" Foreground="#7D806E"/><TextBlock x:Name="RemainingBalance" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#4F7862"/>
                </Grid>
                <TextBlock x:Name="PurchaseNote" Text="永久收藏，不会自动装备。确认后扣除鹰币，不支持退款。" FontSize="10" Foreground="#928570" Margin="2,12,2,13" LineHeight="16"/>
                <Grid KeyboardNavigation.TabNavigation="Cycle"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="CancelButton" Content="先等等" IsCancel="True" Click="Cancel_OnClick" TabIndex="0"/>
                    <Button x:Name="ConfirmButton" Grid.Column="2" Content="确认收藏" Style="{StaticResource PetPrimaryButton}" IsDefault="True" Click="Confirm_OnClick" TabIndex="1"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
