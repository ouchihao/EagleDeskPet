<Window x:Class="DuckDeskPet.HonorWallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大头鹰 · 荣誉展览室" Width="856" Height="780" MinWidth="360" MinHeight="360"
        Background="#F8F4EB" Foreground="#493F32" FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        SizeChanged="Window_OnSizeChanged" PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#544D3E"/>
            <Setter Property="Background" Value="#F5F1E8"/>
            <Setter Property="BorderBrush" Value="#DBD7CB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="9" Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E2E7D8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D1DCC5"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#607D60"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterButton" TargetType="RadioButton">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,7,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" CornerRadius="14" Background="#EFEDE5" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E4E8DC"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#62765D"/><Setter Property="Foreground" Value="White"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#AE804C"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="25,21,25,15" BorderBrush="#D8D2C3" BorderThickness="0,0,0,1">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F3EADA"/><GradientStop Color="#E6ECDF" Offset="1"/></LinearGradientBrush></Border.Background>
            <StackPanel>
                <TextBlock Text="EAGLE CLUB / 小事也值得挂起来" FontSize="10" Foreground="#7E826A"/>
                <Grid Margin="0,7,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="荣誉展览室" FontSize="27" FontWeight="Bold"/>
                    <Border Grid.Column="1" Background="#FFFBF3" CornerRadius="10" Padding="12,8" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CountText" FontSize="12" Foreground="#66795D" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                    </Border>
                </Grid>
                <TextBlock Text="把一起干过的小事，铸成值得收藏的纪念币。" TextWrapping="Wrap" Foreground="#837A67" FontSize="11"/>
                <WrapPanel Margin="0,14,0,0">
                    <RadioButton x:Name="AllFilter" Content="全部荣誉" GroupName="Honors" IsChecked="True" Style="{StaticResource FilterButton}" Checked="Filter_OnChecked"/>
                    <RadioButton x:Name="EarnedFilter" Content="已获得" GroupName="Honors" Style="{StaticResource FilterButton}" Checked="Filter_OnChecked"/>
                    <RadioButton x:Name="LockedFilter" Content="待解锁" GroupName="Honors" Style="{StaticResource FilterButton}" Checked="Filter_OnChecked"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="CardScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,6,0,15" CanContentScroll="False" Focusable="True" AutomationProperties.Name="荣誉徽章展柜">
            <StackPanel>
                <ItemsControl x:Name="CardsItems" Margin="16,2,16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6,6,6,9" BorderThickness="1" BorderBrush="#DED4C2" CornerRadius="12" Background="#FFFCF6"
                                    AutomationProperties.Name="{Binding AccessibleLabel}">
                                <Border.Effect><DropShadowEffect BlurRadius="9" ShadowDepth="3" Color="#92836D" Opacity="0.13"/></Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="208"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Border CornerRadius="11,11,0,0" BorderBrush="#E2D7C3" BorderThickness="0,0,0,3">
                                        <Border.Background>
                                            <RadialGradientBrush GradientOrigin="0.46,0.36" RadiusX="0.7" RadiusY="0.8">
                                                <GradientStop Color="#FFFDF7"/><GradientStop Color="#E4DAC7" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Border VerticalAlignment="Bottom" Height="7">
                                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#DDCEB5"/><GradientStop Color="#F4E7CF" Offset="0.45"/><GradientStop Color="#D3BE9E" Offset="1"/></LinearGradientBrush></Border.Background>
                                            </Border>
                                            <Grid Width="184" Height="184" VerticalAlignment="Center" Margin="0,12,0,0">
                                                <Ellipse Width="172" Height="20" Fill="#217F694B" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
                                                <Grid x:Name="MedalHost" Width="166" Height="166" Opacity="{Binding BadgeOpacity}"
                                                      RenderTransformOrigin="0.5,0.5" Loaded="Medal_OnLoaded" Unloaded="Medal_OnUnloaded"
                                                      MouseEnter="Medal_OnMouseEnter" MouseLeave="Medal_OnMouseLeave" ToolTip="{Binding BadgeLabel}">
                                                    <Grid.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Grid.RenderTransform>
                                                    <Grid.Effect><DropShadowEffect BlurRadius="13" ShadowDepth="6" Color="#665138" Opacity="0.3"/></Grid.Effect>
                                                    <Grid Width="166" Height="166">
                                                        <Grid.Clip><EllipseGeometry Center="83,83" RadiusX="83" RadiusY="83"/></Grid.Clip>
                                                        <!-- The generated files are RGB, not alpha cutouts. Clip the plain exterior
                                                             in native UI; a slight overscan keeps its background out of the rim. -->
                                                        <Image Source="{Binding BadgeUri}" Width="174" Height="174" Margin="-4" Stretch="Fill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{Binding BadgeLabel}"/>
                                                        <Rectangle x:Name="MedalSheen" Width="64" Height="240" Opacity="0" IsHitTestVisible="False">
                                                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFFFFF"/><GradientStop Color="#DFFFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                                                            <Rectangle.RenderTransform><TransformGroup><RotateTransform Angle="-24" CenterX="32" CenterY="120"/><TranslateTransform X="-190"/></TransformGroup></Rectangle.RenderTransform>
                                                        </Rectangle>
                                                        <Ellipse Stroke="{Binding RimBrush}" StrokeThickness="1.2" IsHitTestVisible="False"/>
                                                    </Grid>
                                                </Grid>
                                                <Border Visibility="{Binding LockedVisibility}" Width="24" Height="24" Background="#EDE9DF" CornerRadius="12"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,5" ToolTip="继续陪伴，点亮这枚徽章">
                                                    <Path Data="M 5,9 L 5,5 C 5,0 15,0 15,5 L 15,9 M 3,9 L 17,9 L 17,19 L 3,19 Z M 10,12 L 10,16"
                                                          Stroke="#847A67" StrokeThickness="1.6" Width="12" Height="14" Stretch="Uniform"/>
                                                </Border>
                                            </Grid>
                                            <Border CornerRadius="5" Padding="7,3" Background="{Binding TierTint}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,9,0,0">
                                                <TextBlock Text="{Binding TierLabel}" FontSize="10" Foreground="#665242"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="15,12,15,15">
                                        <TextBlock Text="{Binding SeriesLabel}" FontSize="10" Foreground="#94846B"/>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Margin="0,4,0,6"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#81745E" TextWrapping="Wrap" MinHeight="33"/>
                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,12,0,7" BorderThickness="0" Foreground="{Binding RimBrush}" Background="#EAE5DA" AutomationProperties.Name="{Binding ProgressLabel}"/>
                                        <DockPanel>
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontSize="10" DockPanel.Dock="Right"/>
                                            <TextBlock Text="{Binding ProgressLabel}" FontSize="10" Foreground="#8B7B64"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Text="这边暂时还没有徽章，先给小鹰喂一口饭吧。" Visibility="Collapsed" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="28,45" Foreground="#8C826B"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#F0ECE1" BorderBrush="#DCD5C6" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="铜 · 初识　银 · 熟络　金 · 默契" FontSize="11" Foreground="#88704D" TextWrapping="Wrap"/>
                    <TextBlock Text="悬停欣赏铸纹 · 动效遵循系统设置 · 收藏不消耗粮食或经验" FontSize="10" Foreground="#96917C" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="看够啦" Click="Close_OnClick" IsCancel="True" VerticalAlignment="Center" AutomationProperties.Name="关闭荣誉展览室"/>
            </Grid>
        </Border>
    </Grid>
</Window>
