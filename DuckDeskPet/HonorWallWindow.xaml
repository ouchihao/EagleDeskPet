<Window x:Class="DuckDeskPet.HonorWallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大头鹰 · 荣誉展览室" Width="960" Height="760" MinWidth="360" MinHeight="530"
        Background="#FFF7E8" Foreground="#263C4C" FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        SizeChanged="Window_OnSizeChanged" PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/><Setter Property="Foreground" Value="#284A5A"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Item" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent"><TextBlock Text="{Binding Name}"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#D8EEE2"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#F2E2B9"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#284A5A"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" ClickMode="Press">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" CornerRadius="10" Background="#F2EADA" BorderBrush="#D6C8AA" BorderThickness="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D8EEE2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <TextBlock x:Name="SelectedSeriesLabel" Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}" Margin="11,7,25,7" IsHitTestVisible="False"/>
                    <TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,2" IsHitTestVisible="False"/>
                    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                        <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#FFF7E8" BorderBrush="#C9B985" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,4,0,0"><ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer></Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="#D8EEE2"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#263C4C"/><Setter Property="Background" Value="#FFF7E8"/>
            <Setter Property="BorderBrush" Value="#D6C8AA"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D8EEE2"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#B6DACB"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B88631"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FilterButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#536879"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Surface" CornerRadius="13" Background="#F2EADA" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D8EEE2"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#284A5A"/><Setter Property="Foreground" Value="#FFF5DC"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#DDA843"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#FFF7E8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="22,17,22,13">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="EAGLE CLUB  /  慢慢养，慢慢闪亮" FontSize="10" Foreground="#8A7650"/>
                        <TextBlock Text="鹰的荣誉收藏馆" FontSize="27" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,4"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="14" Background="#284A5A" Padding="14,9" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock x:Name="CountText" FontSize="12" Foreground="#F5D681" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                    </Border>
                </Grid>
                <TextBlock Text="每一顿饭、每一次惦记，都在这里留下鹰的铸纹。" Foreground="#748083" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,12"/>
                <WrapPanel>
                    <RadioButton x:Name="AllFilter" Content="全部" GroupName="Honors" IsChecked="True" Style="{StaticResource FilterButton}" Checked="Filter_OnChecked"/>
                    <RadioButton x:Name="EarnedFilter" Content="已获得" GroupName="Honors" Style="{StaticResource FilterButton}" Checked="Filter_OnChecked"/>
                    <RadioButton x:Name="LockedFilter" Content="待解锁" GroupName="Honors" Style="{StaticResource FilterButton}" Checked="Filter_OnChecked"/>
                    <ComboBox x:Name="SeriesFilter" Width="140" Margin="7,0,0,0" Padding="7,5" DisplayMemberPath="Name" SelectedValuePath="Series" SelectionChanged="Series_OnChanged" AutomationProperties.Name="按荣誉系列筛选"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Margin="14,0,14,0" CornerRadius="17" BorderBrush="#52696C" BorderThickness="1" ClipToBounds="True">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#355365"/><GradientStop Color="#1C3442" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid>
                <Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Viewbox="0,0,24,24" ViewboxUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="#206ED4CC"><GeometryDrawing.Geometry><EllipseGeometry Center="2,2" RadiusX="1" RadiusY="1"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Grid.Background>
                <ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="5,9" CanContentScroll="False" Focusable="True" AutomationProperties.Name="分页荣誉展柜">
                    <Grid>
                        <ItemsControl x:Name="CardsItems" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <ItemsControl.RenderTransform><TranslateTransform/></ItemsControl.RenderTransform>
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Height="216" Margin="6" CornerRadius="12" BorderBrush="#C7B185" BorderThickness="1" Background="#FFF8E8" AutomationProperties.Name="{Binding AccessibleLabel}">
                                    <Border.Effect><DropShadowEffect BlurRadius="9" ShadowDepth="4" Opacity="0.22"/></Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="116"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Border CornerRadius="11,11,0,0" BorderThickness="0,0,0,4" BorderBrush="#C3A679">
                                            <Border.Background><RadialGradientBrush GradientOrigin="0.45,0.2" RadiusX="0.8" RadiusY="0.9"><GradientStop Color="#FFF3CF"/><GradientStop Color="#DDCFB3" Offset="1"/></RadialGradientBrush></Border.Background>
                                            <Grid>
                                                <Ellipse Width="126" Height="10" Fill="#28433A24" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                                <Grid x:Name="MedalHost" Width="104" Height="104" Opacity="{Binding BadgeOpacity}" RenderTransformOrigin="0.5,0.5" Loaded="Medal_OnLoaded" Unloaded="Medal_OnUnloaded" MouseEnter="Medal_OnMouseEnter" MouseLeave="Medal_OnMouseLeave" ToolTip="{Binding BadgeLabel}">
                                                    <Grid.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Grid.RenderTransform>
                                                    <Grid.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="4" Color="#665138" Opacity="0.3"/></Grid.Effect>
                                                    <Grid Width="104" Height="104">
                                                        <Grid.Clip><EllipseGeometry Center="52,52" RadiusX="52" RadiusY="52"/></Grid.Clip>
                                                        <Image Source="{Binding BadgeUri}" Width="110" Height="110" Margin="-3" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{Binding BadgeLabel}"/>
                                                        <Rectangle x:Name="MedalSheen" Width="64" Height="180" Opacity="0" IsHitTestVisible="False">
                                                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFFFFF"/><GradientStop Color="#DFFFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                                                            <Rectangle.RenderTransform><TransformGroup><RotateTransform Angle="-24" CenterX="32" CenterY="90"/><TranslateTransform X="-190"/></TransformGroup></Rectangle.RenderTransform>
                                                        </Rectangle>
                                                        <Ellipse Stroke="{Binding RimBrush}" StrokeThickness="1" IsHitTestVisible="False"/>
                                                    </Grid>
                                                </Grid>
                                                <Border Background="{Binding TierTint}" CornerRadius="5" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"><TextBlock Text="{Binding TierLabel}" FontSize="10" Foreground="#665242"/></Border>
                                                <Border Visibility="{Binding LockedVisibility}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#EDE9DF" CornerRadius="8" Padding="6,3" Margin="6"><TextBlock Text="待解锁" FontSize="9" Foreground="#7B756A"/></Border>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" Margin="11,7,11,6">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccessibleLabel}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SeriesLabel}" FontSize="9" Foreground="#887855" Margin="5,3,0,0"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="10" Foreground="#737A76" TextWrapping="Wrap" Margin="0,4,0,2"/>
                                            <StackPanel Grid.Row="2">
                                                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Height="4" BorderThickness="0" Foreground="{Binding RimBrush}" Background="#E7DFD0" AutomationProperties.Name="{Binding ProgressLabel}"/>
                                                <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontSize="9"/><TextBlock Text="{Binding ProgressLabel}" Foreground="#8B7B64" FontSize="9"/></DockPanel>
                                                <Button Visibility="{Binding RewardVisibility}" Content="{Binding RewardActionLabel}" ToolTip="{Binding RewardLabel}" IsEnabled="{Binding CanUseReward}" Click="Reward_OnClick" Padding="7,2" FontSize="10" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <TextBlock Text="✧" FontSize="56" Foreground="#E8C771" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Margin="0,14,0,0" Foreground="#E2E9E2"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="20,10,20,13">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel HorizontalAlignment="Center">
                <Button x:Name="PreviousPageButton" Content="‹ 上一柜" Click="PreviousPage_OnClick" Padding="11,5" AutomationProperties.Name="上一页荣誉"/>
                <TextBlock x:Name="PageText" Margin="15,7" Foreground="#687F87" FontSize="11" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="NextPageButton" Content="下一柜 ›" Click="NextPage_OnClick" Padding="11,5" AutomationProperties.Name="下一页荣誉"/>
            </WrapPanel>
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="FooterCaption" VerticalAlignment="Center"><TextBlock Text="铜 · 初识　银 · 熟络　金 · 默契" TextWrapping="Wrap" FontSize="10" Foreground="#9E8757"/><TextBlock x:Name="RewardStatusText" Text="悬停欣赏铸纹 · 用小事收藏闪光" Foreground="#788887" FontSize="10" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel>
                <WrapPanel Grid.Column="1"><Button x:Name="ShopButton" Content="逛商店" Click="Shop_OnClick" Padding="10,6" Margin="6,0,0,0"/><Button x:Name="CollectionButton" Content="收藏" Click="Collection_OnClick" Padding="10,6" Margin="6,0,0,0"/><Button Content="看够啦" Click="Close_OnClick" IsCancel="True" Padding="10,6" Margin="6,0,0,0" AutomationProperties.Name="关闭荣誉展览室"/></WrapPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
