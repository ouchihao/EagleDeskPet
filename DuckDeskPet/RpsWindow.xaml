<Window x:Class="DuckDeskPet.RpsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大头鹰 · 摸鱼猜拳局" Width="460" Height="470" MinWidth="380" MinHeight="400"
        Background="#FFF9EF" Foreground="#493827" FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="Window_OnLoaded" PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/PetTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource PetButton}"/>
            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#E8ECDD" Padding="24,20,24,17" BorderBrush="#D4DAC8" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="EAGLE CLUB / 工间休息" FontSize="10" Foreground="#7A826A"/>
                <TextBlock Text="摸鱼猜拳局" FontSize="25" FontWeight="Bold" Margin="0,5,0,0"/>
                <TextBlock Text="输赢随缘，鹰格不能输。" Foreground="#79806A" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20">
                <Border Background="#FFFFFF" BorderBrush="#E6DCC9" BorderThickness="1" CornerRadius="14" Padding="17">
                    <StackPanel>
                        <TextBlock x:Name="StageText" Text="小鹰正在偷偷选拳…" FontSize="16" FontWeight="Bold" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="DetailText" Text="不用下注，也不会扣饭。" FontSize="12" Foreground="#81755F" Margin="0,9,0,0" MinHeight="34"/>
                        <ProgressBar x:Name="RoundProgress" Height="4" Minimum="0" Maximum="10" Value="0" Margin="0,13,0,0"
                                     BorderThickness="0" Foreground="#8E9E7B" Background="#EFEBE0" AutomationProperties.Name="本局演出进度"/>
                    </StackPanel>
                </Border>
                <UniformGrid Columns="3" Margin="-4,17,-4,0">
                    <Button x:Name="RockButton" Click="Choice_OnClick" Tag="Rock" Margin="4,0" Padding="8,13" AutomationProperties.Name="选择石头">
                        <StackPanel><TextBlock Text="石头" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="稳一点" FontSize="10" Foreground="#8B816B" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="ScissorsButton" Click="Choice_OnClick" Tag="Scissors" Margin="4,0" Padding="8,13" AutomationProperties.Name="选择剪刀">
                        <StackPanel><TextBlock Text="剪刀" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="皮一下" FontSize="10" Foreground="#8B816B" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="PaperButton" Click="Choice_OnClick" Tag="Paper" Margin="4,0" Padding="8,13" AutomationProperties.Name="选择布">
                        <StackPanel><TextBlock Text="布" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="全拿捏" FontSize="10" Foreground="#8B816B" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                </UniformGrid>
                <TextBlock x:Name="RewardText" Text="每 5 分钟最多心情 +2；不获得经验或鹰币。" Foreground="#8B816B" FontSize="11" Margin="2,14,2,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#F4EFE4" BorderBrush="#E4DCCA" BorderThickness="0,1,0,0" Padding="24,13">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="ReplayButton" Content="再来一局" HorizontalAlignment="Left" Click="Replay_OnClick" IsEnabled="False"/>
                <Button x:Name="ExitButton" Grid.Column="1" Content="收摊退出" Click="Exit_OnClick" Margin="10,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
